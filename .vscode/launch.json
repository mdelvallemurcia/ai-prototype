{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chat app",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Start MealMate DB",
      "module": "streamlit",
      "args": ["run", "src/web/app.py"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Worker: ingest (example tasks)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Start MealMate DB",
      "module": "src.worker.cli",
      "args": ["ingest", "--tasks", "examples/ingest-tasks.example.yaml"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Worker: ingest (prompt for tasks file)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "Start MealMate DB",
      "module": "src.worker.cli",
      "args": ["ingest", "--tasks", "${input:tasksFile}"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "inputs": [
    {
      "id": "tasksFile",
      "type": "promptString",
      "description": "Path to a YAML or JSON task-list file",
      "default": "examples/ingest-tasks.example.yaml"
    }
  ]
}
