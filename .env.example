# MealMate AI -- environment configuration template
# Copy to .env and fill in your values: cp .env.example .env

# --- Required for chat ---
MEALMATE_NVIDIA_API_KEY=          # Get from https://build.nvidia.com (nvapi-...)

# --- Optional: LLM model (default shown) ---
MEALMATE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Required only for ingestion/RAG (not needed for chat) ---
MEALMATE_NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
MEALMATE_DB_URL=postgresql+psycopg://mealmate:mealmate_dev@localhost:5432/mealmate
